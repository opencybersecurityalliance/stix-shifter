{
    "connection": {
        "type": {
            "displayName": "Stellar Cyber",
            "group": "stellarcyber",
            "type": "connectorType"
        },
        "host": {
            "type": "text",
            "regex": "^(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9_:/\\-]*[a-zA-Z0-9])\\.)*([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9_:/\\-]*[A-Za-z0-9])$"
        },
        "help": {
            "type": "link",
            "default": "data-sources.html"
        }
    },
    "configuration": {
        "auth": {
            "type": "fields",
            "user_id": {
                "type": "text"
            },
            "api_key": {
                "type": "password"
            }
        }
    }
}